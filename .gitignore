# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.conda/

# Build
dist/
build/
*.egg-info/
*.spec

# Output
output/
*.xlsx
*.pdf
*.docx
# Carrier exception — tests/fixtures/sample_bill.pdf is the
# synthetic EDF bill the integration test parses end-to-end.
# All other PDFs (output reports, generated bundles) stay ignored.
!tests/fixtures/*.pdf

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/
.hermes/
.coverage*
# Local-only tooling caches + regenerable index databases.
# These can be hundreds of MB and are rebuilt on demand by the
# respective tool — never source-controlled.
.mypy_cache/
.ruff_cache/
.codegraph/
# Omo scratch dir used by the orchestration tooling.
.omo/
# magic-context project-local config + session artefacts.
# Sibling of the user-level `~/.config/cortexkit/`; holds
# compressed historian/dreamer/sidekick session data.
.cortexkit/

# OS
.DS_Store
Thumbs.db

# Test
.pytest_cache/
.coverage
htmlcov/
.tox/
# Coverage report artifacts — produced by ``pytest --cov`` across
# every CI run; nothing in the project consumes them outside pytest.
coverage.xml

# Local data
*.pst
*.ost
# Root-level data/ holds local exports; edf_bill_fetcher/data/ is a
# packaged resource and must stay tracked.
/data/

# Scratch / debug scripts moved out of the source tree during
# cleanup.  These are one-off investigation scripts that the
# night-shift model left in the working tree; they don't belong in
# version control but should stay on disk in case the user wants
# to recover a probe.
scratch/

# Subagent scratch directory — must be outside repo and
# should NOT be tracked. See .omo/ as the approved scratch path.
.superpowers/

# Internal-only design specs / superpowers workflow artefacts.
# Public documentation lives under docs/ root-level topics; the
# superpowers/ subtree is internal-only planning material that
# should not be visible in a public docs tree.
docs/superpowers/
