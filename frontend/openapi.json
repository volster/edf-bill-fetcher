  "components": {
    "schemas": {
      "Asset": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "auto",
              "pdf_dir",
              "eml_dir",
              "msg_dir",
              "pst",
              "ost",
              "htm",
              "result",
              "workbook",
              "bundle"
            ],
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["name", "kind"],
        "title": "Asset",
        "description": "Named upload collection, finalized before extraction may read it."
      },
      "CompleteFile": {
        "properties": {
          "size": {
            "type": "integer",
