{
  "name": "edf-evidence-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/install.mjs",
    "test": "playwright test",
    "check": "tsc -b",
    "format": "prettier --write src scripts/*.mjs tests *.ts *.json",
    "format:check": "prettier --check src scripts/*.mjs tests *.ts *.json",
    "generate": "python scripts/export_openapi.py && openapi-typescript openapi.json -o src/generated.ts && prettier --write src/generated.ts openapi.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.13.0",
    "echarts": "^6.0.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.548.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
